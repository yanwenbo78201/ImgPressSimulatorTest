import UIKit

@objc class SwiftCompressor: NSObject, ImageCompressorProtocol {

    @objc func compressImage(_ image: UIImage, error: NSErrorPointer) -> Data? {
        return image.jpegData(compressionQuality: 0.8)
    }

    @objc func compressorName() -> String {
        return "SwiftCompressor"
    }
}
